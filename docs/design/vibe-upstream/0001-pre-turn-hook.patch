+    async def _run_pre_turn_hooks(
+        self,
+    ) -> AsyncGenerator[HookEvent | HookUserMessage]:
+        if not self._hooks_manager:
+            return
+        invocation = PreTurnInvocation(**self._hook_session_context().model_dump())
+        async for ev in self._hooks_manager.run(invocation):
+            if isinstance(ev, (HookEvent, HookUserMessage)):
+                yield ev
+
+    async def _dispatch_pre_turn_hooks(
+        self,
+    ) -> tuple[list[LLMMessage], list[HookEvent]]:
+        """Run pre-turn hooks; return (context messages, events).
+
+        The mirror of :meth:`_dispatch_post_turn_hooks`. Each ``HookUserMessage``
+        becomes an ``injected`` user message placed BEFORE the model thinks, which
+        is what makes per-turn recalled memory possible without the user restating
+        it every turn.
+        """
+        from vibe.core.types import LLMMessage, Role
+
+        events: list[HookEvent] = []
+        messages: list[LLMMessage] = []
+        async for hook_event in self._run_pre_turn_hooks():
+            if isinstance(hook_event, HookUserMessage):
+                messages.append(
+                    LLMMessage(role=Role.user, content=hook_event.content, injected=True)
+                )
+            else:
+                events.append(hook_event)
+        return messages, events
+
     async def _run_pre_tool_hooks(
