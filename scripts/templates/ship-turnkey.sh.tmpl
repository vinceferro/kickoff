#!/usr/bin/env bash
# ============================================================================
# ship-@@VER@@.sh — publish @@TAG@@. THE GATED STEP: this fast-forwards the public
# remote's main and pushes the tag. Everything above the push is a refusal looking
# for a reason to fire.
#
#   GENERATED by `adopt-manifest.py gen-ship-turnkey` — do not hand-retarget.
#   @@PROV@@
#
#   Preview:  bash @@SELF@@            # shows exactly what would happen, pushes NOTHING
#   Ship:     bash @@SELF@@ --push     # fast-forward main, tag, push the tag
#
#   THE GATE VERDICT, STATED BESIDE THE COMMIT IT WAS MEASURED ON — never a claim
#   copied forward from a previous cut. A release turnkey once advertised a gate run
#   from a DIFFERENT commit for a full day, while the branch it offered to ship still
#   carried the very blocker the release was being held for. A verdict without the SHA
#   it was measured on is a rumour, and this file refuses to carry one.
#
#     verdict:   @@VERDICT@@
#     gated at:  @@GATED_AT@@
#     branch:    @@BR@@
#     previous:  @@PREV_TAG@@
#
#   FAIL-CLOSED, in this order: the branch must still fast-forward the remote's main,
#   the tag must not already exist, the branch tip must BE the gated commit, and the
#   plugin-version invariant must hold. Any one of them failing exits non-zero having
#   pushed nothing. PREVIEW is the default; --push is the only path to a push.
# ============================================================================
set -uo pipefail

say() { printf '  %s\n' "$*"; }
die() { printf '✗ %s\n' "$*" >&2; exit 1; }

# ── what this turnkey ships ─────────────────────────────────────────────────────────────────────
# Every value below was regex-validated AND shell-quoted by the generator (reject, never sanitize) —
# it emits BASH the operator runs as himself, so a `$(…)` in any of these would run in his shell.
# Each default is pre-quoted into its OWN var and then expanded, NEVER interpolated into a nested
# `${VAR:-word}` default (where `word` is STILL EXPANDED — the concrete command-execution hole).
_DEF_REPO=@@REPO_Q@@
_DEF_BR=@@BR_Q@@
_DEF_TAG=@@TAG_Q@@
_DEF_PREV=@@PREV_TAG_Q@@
_DEF_VERDICT=@@VERDICT_Q@@
REPO="${SHIP_REPO:-$_DEF_REPO}"      # SHIP_REPO exists for the hermetic fixture run
BR="$_DEF_BR"
TAG="$_DEF_TAG"
PREV_TAG="$_DEF_PREV"
VERDICT="$_DEF_VERDICT"
# HARDCODED, not `${SHIP_REMOTE:-origin}`: an env-overridable remote retargets the ONE irreversible
# act in this file — the push — and it had zero legitimate consumers. SHIP_REPO stays because the
# hermetic fixture genuinely needs to point the script at a throwaway tree; nothing needs to point
# the PUSH somewhere else, and an escape hatch nobody uses is one only an attacker (or a hurried
# future edit) will find.
REMOTE="origin"
MAIN="main"

# ── argv: PREVIEW by default. There is no way to reach a push except --push ──────────────────────
PUSH=0
case "${1:-}" in
  --push)    PUSH=1 ;;
  -h|--help) printf '%s\n' "usage: bash $0 [--push]   (no flag = PREVIEW — pushes nothing)"; exit 0 ;;
  "")        : ;;
  *)         die "unknown argument: ${1} (usage: bash $0 [--push])" ;;
esac

cd "$REPO" || die "no repo at $REPO"
echo "▶ ship $TAG"
say "gate verdict   : $VERDICT"

git fetch -q "$REMOTE" --tags 2>/dev/null || die "git fetch $REMOTE failed — is the remote reachable?"

# ── preconditions (all must hold, or refuse) ─────────────────────────────────────────────────────
BRC="$(git rev-parse "$BR" 2>/dev/null)"     || die "branch $BR not found — nothing staged"
PARENT="$(git rev-parse "$BR^" 2>/dev/null)"
OMAIN="$(git rev-parse "$REMOTE/$MAIN" 2>/dev/null)" || die "$REMOTE/$MAIN not found — is $REMOTE fetched?"
git rev-parse -q --verify "refs/tags/$PREV_TAG^{commit}" >/dev/null 2>&1 \
  || die "previous tag $PREV_TAG not found — the plugin invariant below diffs against it"
say "release commit : $(git rev-parse --short "$BR")  $(git log -1 --format=%s "$BR" | cut -c1-56)"
say "$REMOTE/$MAIN    : $(git rev-parse --short "$REMOTE/$MAIN")"

if [ "$PARENT" != "$OMAIN" ]; then
  echo "✗ $BR no longer fast-forwards $REMOTE/$MAIN (its parent $(git rev-parse --short "$BR^") != $REMOTE/$MAIN $(git rev-parse --short "$REMOTE/$MAIN"))."
  echo "  $REMOTE/$MAIN moved since staging. Re-stage the release before shipping. NOT pushing."
  exit 1
fi
if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null 2>&1 || git ls-remote --tags "$REMOTE" "$TAG" | grep -q "$TAG"; then
  echo "✗ tag $TAG already exists (local or $REMOTE). A published tag is not re-cut. NOTHING to do."
  exit 1
fi
say "precondition   : clean fast-forward, tag is new ✓"

# ── freshness: is this the tree that was GATED? ──────────────────────────────────────────────────
# The checks above ALL PASS ON A STALE BRANCH: it still fast-forwards, the tag is still new, and the
# plugin invariant still holds. That is exactly how a staged release sat for a day carrying the very
# blocker its release was held for, while the turnkey's header advertised a gate run from ANOTHER
# commit. So pin the SHA the gate actually certified and refuse anything else. This guard is the
# reason the pushes below may skip the pre-push hook — delete it and that justification dies with it.
GATED_AT="@@GATED_AT@@"
if [ "$BRC" != "$GATED_AT" ]; then
  echo "✗ $BR is ${BRC:0:7}, but the gate certified ${GATED_AT:0:7}."
  echo "  The branch MOVED after it was gated — re-run the release gate on the CURRENT tip before"
  echo "  shipping. A green recorded against a different tree is not a green. NOT pushing."
  exit 1
fi
say "gated tree     : ${GATED_AT:0:7} matches the branch tip ✓"

# The plugin version bump is what keeps every adopter's `kickoff pull` from failing closed at the
# plugin-cache byte-verify. The invariant is CONDITIONAL and this script states it that way on
# purpose: the bump is required *if and only if* plugin/ content changed. An earlier hand-written
# copy of this turnkey hard-required a bump unconditionally — correct for the release it was written
# for (which did change plugin/), and a false refusal for any release that does not. Mirror
# release-gate.sh's check_plugin_version_vs_content exactly: diff the whole plugin/ tree
# (plugin.json INCLUDED — the preflight byte-verify hashes it too).
if git diff --quiet "$PREV_TAG" "$BR" -- ':/plugin'; then
  say "plugin content : unchanged vs $PREV_TAG — no version bump required (invariant holds vacuously) ✓"
else
  PV_NEW="$(git show "$BR:plugin/.claude-plugin/plugin.json" 2>/dev/null | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
  PV_OLD="$(git show "$PREV_TAG:plugin/.claude-plugin/plugin.json" 2>/dev/null | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
  if [ -z "$PV_NEW" ] || [ "$PV_NEW" = "$PV_OLD" ]; then
    echo "✗ plugin/ content CHANGED but plugin.json version did not ($PREV_TAG='$PV_OLD' → $BR='$PV_NEW')."
    echo "  Every adopter's \`kickoff pull\` would fail closed at the plugin-cache byte-verify. NOT pushing."
    exit 1
  fi
  say "plugin version : $PV_OLD → $PV_NEW ✓"
fi

# The installer sha the release notes quote — read from the RELEASE TREE, never from the dev checkout.
INSTALL_SHA=""
if git cat-file -e "$BR:install.sh" 2>/dev/null; then
  INSTALL_SHA="$(git show "$BR:install.sh" | sha256sum | cut -d' ' -f1)"
  say "install.sh sha : $INSTALL_SHA  (paste into the release notes)"
else
  say "install.sh     : not present in $BR — the post-push installer verification will be skipped"
fi

# The public raw-installer URL is DERIVED from the remote at run time, never baked: a turnkey that
# hardcodes an owner/repo slug LIES the moment the remote is re-pointed, and it would carry an
# identity literal into a generated file for no reason.
SLUG=""
ORIGIN_URL="$(git remote get-url "$REMOTE" 2>/dev/null || true)"
case "$ORIGIN_URL" in
  git@github.com:*)       SLUG="${ORIGIN_URL#git@github.com:}" ;;
  ssh://git@github.com/*) SLUG="${ORIGIN_URL#ssh://git@github.com/}" ;;
  https://github.com/*)   SLUG="${ORIGIN_URL#https://github.com/}" ;;
esac
SLUG="${SLUG%.git}"

if [ "$PUSH" -eq 0 ]; then
  echo
  echo "  PREVIEW ONLY — nothing pushed. On --push this will:"
  echo "    1. git push --no-verify $REMOTE $BR:$MAIN    # fast-forward $REMOTE/$MAIN → the release commit"
  echo "    2. git tag -a $TAG -m '$TAG' $BR             # annotated tag on the release commit"
  echo "    3. git push --no-verify $REMOTE $TAG         # publish the tag (the irreversible step)"
  echo "    4. create the GitHub Release for $TAG (notes ASSEMBLED from CORE-CHANGELOG's $TAG section + installer sha)"
  echo
  echo "  Ship it:  bash $0 --push"
  exit 0
fi

# ── the gated push ───────────────────────────────────────────────────────────────────────────────
echo

# ── why these pushes skip the pre-push hook ──────────────────────────────────────────────────────
# This repo's pre-push runs the full declared suite battery. The release gate ALREADY ran those
# suites, and it ran them on a detached worktree of the EXACT commit being pushed (GATED_AT above,
# re-asserted before we got here). Letting the hook fire again costs another full suite pass PER
# PUSH — twice, since main and the tag are separate pushes — and, worse, it would run them against
# THIS working tree, not the release tree: the dev checkout carries files the release commit does
# not, so it is not even the thing being shipped. Skipping is safe here for ONE specific reason, and
# only that one: the freshness guard proved the tip is byte-identical to what the gate certified.
# Never `--no-verify` a push that was not gated.
say "1/3 fast-forwarding $REMOTE/$MAIN … (pre-push skipped: the gate already ran the suites on ${GATED_AT:0:7})"
git push --no-verify "$REMOTE" "$BR:$MAIN"   || die "push to $MAIN failed"
say "2/3 tagging $TAG …"
git tag -a "$TAG" -m "$TAG" "$BR"            || die "tag failed"
say "3/3 pushing the tag …"
git push --no-verify "$REMOTE" "$TAG"        || die "tag push failed ($MAIN already moved — the tag exists locally; retry just the tag push)"

echo
say "✓ pushed. $TAG is on $REMOTE."

# ── 4/4 publish the GitHub Release — SYSTEMATIC, notes DERIVED from the tagged tree ──────────────
# Operator directive (2026-08-24): every deploy publishes its Release page as part of the ship,
# never as a remembered after-step. The notes are ASSEMBLED, not authored here: the topmost
# CORE-CHANGELOG section OF THE TAGGED TREE (so the page cannot contradict what shipped) plus the
# derivable upgrade/install lines and the installer sha. gh missing/unauthed/non-GitHub remote is a
# DEGRADE, not a die — the irreversible step is already done; write the assembled notes to disk and
# print the exact manual command instead.
if [ -n "$SLUG" ]; then
  GH_NOTES="$(mktemp)"
  {
    git show "$BR:CORE-CHANGELOG.md" | awk -v sec="## $TAG" '
      $0 == sec { f=1; print; next }
      f && /^## / { exit }
      f { print }'
    printf '\n## Upgrade\n\n```bash\nkickoff pull %s\n```\n\n' "$TAG"
    printf 'First install:\n\n```bash\n'
    printf 'curl -fsSL https://raw.githubusercontent.com/%s/%s/install.sh | sh\n' "$SLUG" "$TAG"
    printf '```\n\ninstall.sh sha256: `%s`\n\n' "$INSTALL_SHA"
    printf 'tag→commit: `%s @ %s`\n' "$TAG" "$GATED_AT"
  } > "$GH_NOTES"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    say "4/4 publishing the GitHub Release (notes assembled from $BR:CORE-CHANGELOG) …"
    if gh release create "$TAG" --repo "$SLUG" --title "$TAG" --notes-file "$GH_NOTES"; then
      say "✓ GitHub Release live: https://github.com/$SLUG/releases/tag/$TAG"
    else
      say "⚠ gh release create failed — the tag IS out; finish by hand (notes ready):"
      say "    gh release create $TAG --repo $SLUG --title $TAG --notes-file $GH_NOTES"
    fi
  else
    say "⚠ gh not available/authed here — Release page NOT created; notes assembled at $GH_NOTES. Finish by hand:"
    say "    gh release create $TAG --repo $SLUG --title $TAG --notes-file $GH_NOTES"
  fi
else
  say "4/4 GitHub Release SKIPPED (remote is not github.com — no Releases surface)."
fi

# ── post-push: verify the LIVE installer, not just the build (a green push is not a live release) ─
if [ -n "$SLUG" ] && [ -n "$INSTALL_SHA" ] && command -v curl >/dev/null 2>&1; then
  say "verifying the live installer resolves to the new tag …"
  sleep 3
  URL="https://raw.githubusercontent.com/$SLUG/$TAG/install.sh"
  TMPI="$(mktemp)"
  CODE="$(curl -fsSL -o "$TMPI" -w '%{http_code}' "$URL" 2>/dev/null || echo 000)"
  if [ "$CODE" = "200" ]; then
    LIVE_SHA="$(sha256sum "$TMPI" | cut -d' ' -f1)"
    if [ "$LIVE_SHA" = "$INSTALL_SHA" ]; then
      say "✓ $URL → 200, sha256 matches the staged tree. $TAG is LIVE."
    else
      say "⚠ installer resolves (200) but sha differs (live $LIVE_SHA != staged $INSTALL_SHA) — investigate before announcing."
    fi
  else
    say "⚠ installer URL not resolving yet (HTTP $CODE) — raw hosting can lag ~1min; re-check: curl -fsSL $URL | sha256sum"
  fi
  rm -f "$TMPI"
else
  say "post-push installer verification SKIPPED (no derivable public slug, no install.sh in $BR, or no curl) — verify by hand before announcing."
fi

echo
say "Done. Tell the coordinator '$TAG shipped' and it will fold the tracker, backfill the changelog"
say "date, verify the tag tree matches what was gated, and hand over the adopter upgrade turnkey."
