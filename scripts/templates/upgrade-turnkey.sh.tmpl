#!/usr/bin/env bash
# ============================================================================
# upgrade-@@NAME@@-to-@@VER@@.sh — @@ORG@@'s one-tap hop to @@TAG@@
#
#   GENERATED by `adopt-manifest.py gen-upgrade-turnkey` — do not hand-retarget.
#   @@PROV@@
#
#   Run:       bash @@SELF@@
#   Rehearse:  bash @@SELF@@ --dry-run      (READ-ONLY — changes nothing)
#   Rollback:  bash @@SELF@@ --rollback [<backup.tar.gz>]
#
#   FAIL-CLOSED: if @@TAG@@ is not on the core remote yet, this exits loudly having
#   changed NOTHING — re-run it after the release lands. An unreachable remote is
#   reported as UNREACHABLE, never as "release missing" (they are different bugs).
#
#   POLICY-NEUTRAL — the invariant this generator exists to enforce. An upgrade
#   changes the VERSION, never the model policy. MODEL/EFFORT are read from THIS
#   adopter's OWN .kickoff/instance.env at RUN time (a subshell source — the same
#   parse the engine's session-run.sh does, so the self-referential `${MODEL:-…}`
#   form resolves to its VALUE, not to a literal). When a pin is GENUINELY UNSET this
#   MIRRORS THE ENGINE exactly: MODEL stays unset (the worker inherits the box's model
#   — session-run.sh adds NO --model — and NOTHING is persisted) and EFFORT defaults to
#   'high' (session-run.sh's own `--effort "${EFFORT:-high}"`), never 'xhigh'. No model
#   family is baked into this file, and a no-pin adopter's instance.env is left
#   UNTOUCHED. (2026-07-13: a hand-retargeted turnkey carried a HARDCODED model default,
#   clobbered an adopter's own MODEL=opus pin, and pointed a live worker at an exhausted
#   model. The mirror-image miss is just as durable — imposing opus/xhigh on a DEFAULT
#   adopter that the engine would run at inherit-box/high. The generator now REFUSES to
#   emit any turnkey that binds a model family, or a non-'high' effort tier, as a default
#   ANYWHERE in the MODEL/EFFORT resolution chain.)
#
#   The autonomy grant travels ARGV / TERMINAL ENV ONLY — never instance.env.
#   PERMISSION_MODE is deliberately OFF the engine's _INSTANCE_ENV_WHITELIST
#   (v0.7 G1 §2.3), so a `PERMISSION_MODE=` line in that file is a no-op that LOOKS
#   like it works and plants an autonomy-arming default for the day the list widens.
#
#   Idempotent: already on @@TAG@@ (engine checkout verified AT the lock commit) with a
#   live worker from the pinned engine → skipped (FORCE=1 to cycle anyway). Blast
#   radius: signals ONLY the exact pid in this org's own supervisor.lock, /proc-verified
#   as a kickoff supervisor OF THIS ORG — never a pattern kill, never a cross-org kill,
#   never KILL -9.
#
#   VERDICT IS CONJUNCTIVE — never rc-only (the v0.4.1→v0.6 lesson: adjudicate on
#   core.lock, not exit messages): pull rc==0 AND anchored 'PULL OK' AND zero
#   '[kickoff] ERROR:' AND core.lock advanced to the target tag+commit (== the new
#   engine's HEAD at the tag) AND the new supervisor alive FROM the new engine dir
#   (/proc cmdline) through a ${UPG_WATCH_SECONDS:-90}s watchdog.
# ============================================================================
set -uo pipefail

say(){ printf '%s\n' "$*"; }
hr(){ printf '%s\n' "────────────────────────────────────────────────────────"; }
die(){ say "✗ $*" >&2; exit 1; }

# ── org config ───────────────────────────────────────────────────────────────
# Each default is pre-quoted into its OWN var by the generator, then expanded — NEVER
# interpolated into a nested `${VAR:-word}` default, where `word` is STILL EXPANDED and a
# `$(…)` in an org name would run in the operator's shell. (The generator also fail-closed
# REFUSES any name/version/org that does not match its strict regex — reject, not sanitize.)
# The UPG_* overrides exist for the hermetic fixture dry-run.
_DEF_ORG=@@ORG_Q@@
_DEF_REPO=@@REPO_Q@@
_DEF_TAG=@@TAG_Q@@
_DEF_BKP=@@BKP_Q@@
ORG="${UPG_ORG:-$_DEF_ORG}"
REPO="${UPG_REPO:-$_DEF_REPO}"
TAG="${TAG:-$_DEF_TAG}"
BACKUP_DIR="${UPG_BACKUP_DIR:-$HOME}"
BACKUP_PREFIX="${UPG_BACKUP_PREFIX:-$_DEF_BKP}"
WATCH_SECONDS="${UPG_WATCH_SECONDS:-90}"

KDIR="$REPO/.kickoff"
IENV="$KDIR/instance.env"
LOCK="$KDIR/supervisor.lock"
SUP_LOG="$KDIR/supervisor.log"

# ── argv ─────────────────────────────────────────────────────────────────────
DRYRUN=0; MODE=run; BK_ARG=""
case "${1:-}" in
  --dry-run)  DRYRUN=1 ;;
  --rollback) MODE=rollback; BK_ARG="${2:-}" ;;
  -h|--help)  say "usage: bash $0 [--dry-run | --rollback [<backup.tar.gz>]]"; exit 0 ;;
  "")         : ;;
  *)          die "unknown argument: ${1} (usage: bash $0 [--dry-run | --rollback [<backup.tar.gz>]])" ;;
esac

# Scrub leak-prone vars so the adopter's own instance.env always wins (the adopt-from-inside-
# a-worker leak class). PERMISSION_MODE/MODEL/EFFORT are scrubbed here and re-supplied
# EXPLICITLY below — the caller's session must never decide this adopter's policy.
SCRUB=(-u TELEGRAM_STATE_DIR -u TELEGRAM_BOT_TOKEN -u MEMORY_INDEX -u MEMORY_DIR -u MEMORY_DB \
       -u MEMORY_HOOK_LOG -u MC_STATE_FILE -u MC_TRACKER_FILE -u KICKOFF_SUPERVISOR_LOG \
       -u KICKOFF_CORE_REMOTE -u KICKOFF_CORE_DIR -u REPO_DIR \
       -u KICKOFF_ADOPTERS_REGISTRY -u KICKOFF_VERSIONS_DIR -u KICKOFF_MODEL_DIR \
       -u CLAUDE_CONFIG_DIR -u INGRESS_DIR -u INGRESS_REPO -u KICKOFF_ENV_KEEP \
       -u _PTY_WRAPPED -u MODEL -u EFFORT -u PERMISSION_MODE -u CHANNEL_SPEC \
       -u REGROUND_PROMPT -u ANNOUNCE_COOLDOWN -u PREFLIGHT_SKIP -u DRY_RUN \
       -u START_CMD -u POLL_SECONDS -u MAX_SESSION_SECONDS -u INSTANCE_ENV -u LOCKFILE)
# The autonomy grant — ARGV/TERMINAL-ENV channel only (see the header). Empty when the
# turnkey was generated with --permission-mode default.
GRANT_ENV=(@@GRANT_ENV@@)
# Fixture passthrough: a dry-run harness sets these to scratch paths; when set in THIS shell
# they are re-applied AFTER the scrub so the fixture stays hermetic.
EXTRA_ENV=()
for _v in KICKOFF_ADOPTERS_REGISTRY KICKOFF_VERSIONS_DIR KICKOFF_MODEL_DIR CLAUDE_CONFIG_DIR; do
  [ -n "${!_v:-}" ] && EXTRA_ENV+=("$_v=${!_v}")
done

# ── helpers ──────────────────────────────────────────────────────────────────
read_env_var(){ # <name> — scoped subshell SOURCE of instance.env (self-ref ${V:-…} forms resolve).
  # This is the engine's REAL parse (session-run.sh). A sed/grep regex over the file returns the
  # LITERAL '${MODEL:-opus}' on the self-ref form scripts/instance.env.example actually ships —
  # which is why the policy read below MUST live under this helper, never above it.
  ( set +u; unset "$1" 2>/dev/null; . "$IENV" >/dev/null 2>&1 || true; printf '%s' "${!1:-}" )
}
lock_field(){ grep -E "^$1 " "$KDIR/core.lock" 2>/dev/null | awk '{print $2}' | head -1; }
bk_tag(){ tar xzOf "$1" .kickoff/core.lock 2>/dev/null | awk '$1=="tag"{print $2; exit}'; }
persist_env_var(){ # <name> <value> — replace any ACTIVE line in instance.env, else append (atomic same-dir tmp; comments untouched)
  local n="$1" v="$2" tmp="$IENV.tmp.$$"
  grep -vE "^[[:space:]]*(export[[:space:]]+)?$n=" "$IENV" > "$tmp" || true
  printf 'export %s="%s"\n' "$n" "$v" >> "$tmp"
  chmod --reference="$IENV" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$IENV" || { rm -f "$tmp"; die "$ORG: could not persist $n=$v into $IENV"; }
}
sup_pid(){ local p; p="$(head -n1 "$LOCK" 2>/dev/null || true)"; case "$p" in ''|0*|*[!0-9]*) p="";; esac; printf '%s' "$p"; }
is_alive(){ [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }
sup_cmdline(){ tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null || true; }
sup_repo(){ tr '\0' '\n' < "/proc/$1/environ" 2>/dev/null | sed -n 's/^REPO_DIR=//p' | head -n1 || true; }

# THE POLICY READ — deliberately BELOW read_env_var (an ordering the generator asserts before it
# will emit this file). An upgrade changes the VERSION, never the model policy: read the adopter's
# OWN pin and MIRROR THE ENGINE EXACTLY when a pin is genuinely UNSET. session-run.sh does two
# things for a no-pin adopter: it adds NO --model (an unset MODEL inherits the box's Claude Code
# model — imposing a family would DOWNGRADE a live coordinator) and it defaults EFFORT to 'high'
# (`--effort "${EFFORT:-high}"`), never 'xhigh'. So: MODEL empty ⇒ inherit the box (no family baked,
# nothing persisted); EFFORT empty ⇒ 'high'. A no-pin adopter is left UNTOUCHED — nothing imposed,
# nothing persisted — which is the true policy-neutral behaviour.
resolve_policy(){
  local _cur_model _cur_effort
  _cur_model="$(read_env_var MODEL)"
  _cur_effort="$(read_env_var EFFORT)"
  # MODEL: empty ⇒ inherit the box (NO family baked as a default); a real pin ⇒ that pin, preserved.
  WORKER_MODEL="${UPG_MODEL:-$_cur_model}"
  # EFFORT: the engine default is 'high' (session-run.sh), NEVER 'xhigh'. A pin wins; else 'high'.
  WORKER_EFFORT="${UPG_EFFORT:-${_cur_effort:-high}}"
  MODEL_PINNED=0;  [ -n "$WORKER_MODEL" ] && MODEL_PINNED=1
  EFFORT_PINNED=0; [ -n "${UPG_EFFORT:-$_cur_effort}" ] && EFFORT_PINNED=1
  # The env the worker start injects: EFFORT ALWAYS (a pin, or the engine default 'high' — which is
  # behaviour-identical to unset); MODEL ONLY when PINNED (an unset MODEL must inherit the box, never
  # be forced onto a family). A no-pin adopter thus starts EXACTLY as the bare engine would.
  POLICY_ENV=(EFFORT="$WORKER_EFFORT")
  [ "$MODEL_PINNED" = 1 ] && POLICY_ENV+=(MODEL="$WORKER_MODEL")
  if [ "$MODEL_PINNED" = 1 ]; then MODEL_DISPLAY="MODEL=$WORKER_MODEL"; else MODEL_DISPLAY="MODEL=<inherit box model>"; fi
  if [ "$MODEL_PINNED" = 1 ] || [ "$EFFORT_PINNED" = 1 ]; then
    POLICY_SRC="preserved from ${IENV##*/}"
  else
    POLICY_SRC="no pin in instance.env → engine default (inherit-box model, effort high) — nothing persisted, nothing imposed"
  fi
}
WORKER_MODEL=""; WORKER_EFFORT=""; POLICY_SRC=""; MODEL_DISPLAY=""
MODEL_PINNED=0; EFFORT_PINNED=0; POLICY_ENV=()

remote_class(){ # <remote> — DERIVED at run time, never baked: a re-pointed remote can't make this lie
  case "$1" in
    /*|file://*) printf 'local path → zero-network pull' ;;
    *)           printf 'remote URL → network pull (needs reachable transport/auth)' ;;
  esac
}

ensure_ssh_keepalive(){ # repo-local git config; idempotent; keeps the pre-push battery's long-lived remote connection alive (a NAT/LB idle window otherwise kills the push SILENTLY after all gates pass — live 2026-08-24 ×3)
  local cur want
  want="ssh -o ServerAliveInterval=20 -o ServerAliveCountMax=9"
  cur="$(git -C "$REPO" config --get core.sshCommand 2>/dev/null || true)"
  if printf '%s' "$cur" | grep -q 'ServerAliveInterval'; then
    say "• ssh keepalive already configured in $REPO (core.sshCommand) — left as-is"
    return 0
  fi
  if git -C "$REPO" config core.sshCommand "$want"; then
    say "• set core.sshCommand keepalives in $REPO ($want) — slow gate batteries can no longer idle-kill your pushes mid-flight"
  else
    say "⚠ could not write core.sshCommand — consider by hand:  git -C \"$REPO\" config core.sshCommand \"$want\""
  fi
}

stop_old_supervisor(){ # TERM the exact lock pid — cmdline-verified kickoff supervisor OF THIS ORG; ≤35s; never KILL -9
  local pid args their i
  pid="$(sup_pid)"
  if ! is_alive "$pid"; then
    say "• $ORG: no live supervisor (lock pid ${pid:-<none>} not running) — nothing to stop"
    return 0
  fi
  args="$(sup_cmdline "$pid")"
  case "$args" in
    *scripts/supervisor.sh*) : ;;
    *) die "$ORG: lock pid $pid is NOT a kickoff supervisor (cmdline: ${args:-<unreadable>}) — refusing to signal; inspect manually (ps -p $pid)" ;;
  esac
  their="$(sup_repo "$pid")"
  if [ -n "$their" ] && [ "$(readlink -f "$their" 2>/dev/null || printf '%s' "$their")" != "$(readlink -f "$REPO" 2>/dev/null || printf '%s' "$REPO")" ]; then
    die "$ORG: lock pid $pid is a kickoff supervisor but NOT this org's (its REPO_DIR: $their) — refusing (never a cross-org kill)"
  fi
  say "• $ORG: stopping OLD supervisor pid $pid (TERM → its trap tears down the session group)…"
  kill -TERM "$pid" 2>/dev/null || true
  for i in $(seq 1 35); do is_alive "$pid" || break; sleep 1; done
  is_alive "$pid" && die "$ORG: supervisor pid $pid still alive after 35s — NOT escalating (never KILL -9); inspect (ps -p $pid), then re-run"
  say "  ↳ stopped clean"
}

tail_log(){ say "  last supervisor.log lines:"; tail -n 25 "$SUP_LOG" 2>/dev/null | sed 's/^/    /' >&2 || true; }

# ── --rollback: restore the pre-upgrade pin + restart the worker ──────────────
if [ "$MODE" = rollback ]; then
  BK="$BK_ARG"
  if [ -z "$BK" ]; then
    # Pick the newest PRE-upgrade backup. One whose core.lock already pins $TAG is a POST-upgrade
    # snapshot: "restoring" it would be a no-op wearing a ROLLED BACK banner.
    while IFS= read -r _cand; do
      if [ "$(bk_tag "$_cand")" != "$TAG" ]; then BK="$_cand"; break; fi
    done < <(ls -1t "$BACKUP_DIR/$BACKUP_PREFIX"-*.tar.gz 2>/dev/null || true)
    [ -n "$BK" ] || die "$ORG rollback: no PRE-upgrade backup found (every $BACKUP_DIR/$BACKUP_PREFIX-*.tar.gz already pins $TAG, or none exist) — pass one explicitly"
  fi
  [ -f "$BK" ] || die "$ORG rollback: backup not found: $BK"
  [ "$(bk_tag "$BK")" != "$TAG" ] || die "$ORG rollback: $BK pins $TAG — that IS the post-upgrade state; restoring it would be a no-op, not a rollback. Pass a pre-upgrade backup."
  say "== $ORG ROLLBACK from $BK =="
  hr
  stop_old_supervisor
  # restore ONLY the pin files the upgrade touched (never state/logs)
  for f in .kickoff/instance.env .kickoff/core.lock .kickoff/adopt-manifest.json; do
    tar tzf "$BK" "$f" >/dev/null 2>&1 && tar xzf "$BK" -C "$REPO" "$f" && say "• restored $f"
  done
  # Resolve policy AFTER the restore — the restored instance.env IS the pre-upgrade pin, so the
  # rolled-back worker comes up on exactly the policy it had before the upgrade.
  resolve_policy
  R_ENGINE="$(read_env_var KICKOFF_CORE_DIR)"
  R_COMMIT="$(lock_field commit)"; R_TAG="$(lock_field tag)"
  [ -d "$R_ENGINE" ] || die "$ORG rollback: restored KICKOFF_CORE_DIR ($R_ENGINE) does not exist"
  if [ "$(git -C "$R_ENGINE" rev-parse HEAD 2>/dev/null)" != "$R_COMMIT" ]; then
    [ -z "$(git -C "$R_ENGINE" status --porcelain 2>&1)" ] || die "$ORG rollback: engine $R_ENGINE is DIRTY — inspect before re-pointing it"
    git -C "$R_ENGINE" checkout -q --detach "$R_COMMIT" || die "$ORG rollback: cannot check out $R_COMMIT in $R_ENGINE"
    say "• re-pointed $R_ENGINE at $R_COMMIT ($R_TAG)"
  fi
  # re-point the adopters-registry row at the restored pin (otherwise it keeps naming the NEW
  # tag/version-dir — drift that misleads future sibling-detection)
  _REG="${KICKOFF_ADOPTERS_REGISTRY:-$HOME/.kickoff/adopters.json}"
  if [ -f "$R_ENGINE/scripts/adopt-manifest.py" ] && \
     python3 "$R_ENGINE/scripts/adopt-manifest.py" adopters-register --repo "$REPO" \
       --tag "$R_TAG" --version-dir "$R_ENGINE" --registry "$_REG" >/dev/null 2>&1; then
    say "• adopters registry re-pointed at $R_TAG ($_REG)"
  else
    say "• note: adopters registry ($_REG) NOT re-pointed — non-fatal, the next pull re-registers"
  fi
  mkdir -p "$(dirname "$SUP_LOG")"
  setsid nohup env "${SCRUB[@]}" ${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"} ${GRANT_ENV[@]+"${GRANT_ENV[@]}"} \
    "${POLICY_ENV[@]}" \
    REPO_DIR="$REPO" KICKOFF_CORE_DIR="$R_ENGINE" KICKOFF_SUPERVISOR_LOG="$SUP_LOG" LOG_MAX_BYTES=10485760 \
    bash "$R_ENGINE/scripts/supervisor.sh" >>"$SUP_LOG" 2>&1 &
  for i in $(seq 1 30); do is_alive "$(sup_pid)" && break; sleep 1; done
  is_alive "$(sup_pid)" || { tail_log; die "$ORG rollback: worker did not come up within 30s"; }
  say "✅ $ORG ROLLED BACK — worker pid $(sup_pid) on $R_ENGINE ($R_TAG) · $MODEL_DISPLAY · EFFORT=$WORKER_EFFORT"
  exit 0
fi

# ── banner + ground checks ────────────────────────────────────────────────────
if [ "$DRYRUN" = 1 ]; then
  say "== $ORG: DRY-RUN of the upgrade to $TAG — READ-ONLY, nothing will be changed =="
else
  say "== $ORG: upgrade to $TAG =="
fi
say "   repo:        $REPO"
[ -f "$IENV" ] || die "$ORG: $IENV missing — is this the right repo?"
[ -f "$KDIR/core.lock" ] || die "$ORG: $KDIR/core.lock missing — this org was never pinned; adopt/pull it first"
OLD_ENGINE="$(read_env_var KICKOFF_CORE_DIR)"
[ -n "$OLD_ENGINE" ] && [ -d "$OLD_ENGINE" ] || die "$ORG: KICKOFF_CORE_DIR from instance.env ('$OLD_ENGINE') is not a directory"
[ -x "$OLD_ENGINE/scripts/kickoff" ] || [ -f "$OLD_ENGINE/scripts/kickoff" ] || die "$ORG: no front door at $OLD_ENGINE/scripts/kickoff"
REMOTE="$(read_env_var KICKOFF_CORE_REMOTE)"
[ -n "$REMOTE" ] || die "$ORG: KICKOFF_CORE_REMOTE not resolvable from instance.env — set it, then re-run"
CUR_TAG="$(lock_field tag)"; CUR_COMMIT="$(lock_field commit)"
resolve_policy
say "   engine now:  $OLD_ENGINE @ ${CUR_TAG:-<no tag>} (${CUR_COMMIT:0:7})"
say "   core remote: $REMOTE  ($(remote_class "$REMOTE"))"
say "   worker cfg:  $MODEL_DISPLAY EFFORT=$WORKER_EFFORT  ($POLICY_SRC — an upgrade changes the VERSION, never the model policy)"
hr
# never against the engine-source origin itself — DERIVED, not a baked machine path
if [ "$(readlink -f "$REPO" 2>/dev/null || printf '%s' "$REPO")" = "$(readlink -f "$REMOTE" 2>/dev/null || printf '%s' "$REMOTE")" ]; then
  die "refusing: $REPO IS the core remote — the kickoff ORIGIN upgrades via git pull, never kickoff pull"
fi
if [ -f "$REPO/scripts/core-manifest.txt" ] && [ -d "$REPO/plugin/.claude-plugin" ]; then
  die "refusing: $REPO looks like the kickoff ENGINE SOURCE tree — it upgrades via git pull, never kickoff pull"
fi

# ── idempotency: already there + alive → done ────────────────────────────────
PIDNOW="$(sup_pid)"
if [ "${FORCE:-0}" != "1" ] && [ "$CUR_TAG" = "$TAG" ] && is_alive "$PIDNOW" \
   && sup_cmdline "$PIDNOW" | grep -qF "$OLD_ENGINE/scripts/supervisor.sh" \
   && [ -n "$CUR_COMMIT" ] && [ "$(git -C "$OLD_ENGINE" rev-parse HEAD 2>/dev/null)" = "$CUR_COMMIT" ]; then
  say "✅ $ORG is ALREADY on $TAG with a live worker (pid $PIDNOW) from the pinned engine — nothing to do (FORCE=1 to cycle anyway)"
  exit 0
fi

# ── fail-closed release gate: the tag must exist on the remote BEFORE we touch anything ──
say "• checking $TAG exists on the core remote…"
GATE_ERR="$(mktemp)"; GATE_RC=0
GATE_OUT="$(timeout 40 git ls-remote --tags "$REMOTE" "refs/tags/$TAG" 2>"$GATE_ERR")" || GATE_RC=$?
REF="${GATE_OUT%%$'\n'*}"
if [ "$GATE_RC" -ne 0 ]; then
  # unreachable ≠ missing release: never tell the operator to wait for a release that may already be out
  [ -s "$GATE_ERR" ] && { say "  git ls-remote said:"; sed 's/^/    /' "$GATE_ERR"; } >&2
  rm -f "$GATE_ERR"
  die "$ORG: cannot REACH the core remote ($REMOTE) — git ls-remote failed (rc=$GATE_RC; 124 = timed out). This is NOT 'release missing': check the remote is reachable/authorised, then re-run. (Nothing was changed.)"
fi
rm -f "$GATE_ERR"
if [ -z "$REF" ]; then
  die "$ORG: release $TAG is NOT on the core remote yet ($REMOTE is reachable; the tag just isn't there) — nothing to upgrade to. Re-run this one-tap after the release lands. (Nothing was changed.)"
fi
say "  ↳ found: ${REF%%$'\t'*}"

# ── --dry-run stops HERE: everything above is read-only; everything below mutates ─────
if [ "$DRYRUN" = 1 ]; then
  hr
  say "DRY-RUN — nothing was changed. The real run would:"
  say "  1. back up $KDIR → $BACKUP_DIR/$BACKUP_PREFIX-<utc>.tar.gz (refusing to proceed without one)"
  say "  2. pull $TAG through the CURRENT engine's front door: $OLD_ENGINE/scripts/kickoff pull $TAG"
  say "  3. adjudicate the CONJUNCTIVE pull verdict on core.lock (never on rc alone)"
  if [ "$MODEL_PINNED" = 1 ] || [ "$EFFORT_PINNED" = 1 ]; then
    say "  4. persist the adopter's OWN pin ($MODEL_DISPLAY EFFORT=$WORKER_EFFORT) into instance.env — PRESERVED, never imposed"
  else
    say "  4. persist NOTHING — no MODEL/EFFORT pin to preserve; the worker inherits the box model at effort high, exactly as the bare engine does (an upgrade changes the VERSION, never the policy)"
  fi
  say "  5. stop the OLD supervisor: the exact pid in $LOCK, /proc-verified as THIS org's (never a pattern kill)"
  say "  6. start the worker from the NEW engine: kickoff @@UP_ARGS@@ (@@PM@@ · $MODEL_DISPLAY · EFFORT=$WORKER_EFFORT)"
  say "  7. watch it survive ${WATCH_SECONDS}s (pid alive + /proc cmdline names the NEW engine)"
  say "  +. ensure ssh keepalives in $REPO (core.sshCommand, idempotent — a slow gate battery must not idle-kill pushes)"
  say ""
  say "✅ DRY-RUN OK — the release gate is green and the plan above is what will run."
  say "   apply it:  bash $0"
  exit 0
fi

# ── backup — ONLY while the pin is still PRE-upgrade. A re-run / FORCE=1 recycle would
#    snapshot the already-upgraded pin, and no-arg --rollback picks the newest backup:
#    that snapshot would poison it. ───────────────────────────────────────────────────
if [ "$CUR_TAG" != "$TAG" ]; then
  TS="$(date -u +%Y%m%dT%H%M%SZ)"
  BK="$BACKUP_DIR/$BACKUP_PREFIX-$TS.tar.gz"
  tar czf "$BK" -C "$REPO" \
    --exclude='.kickoff/state' --exclude='.kickoff/supervisor.log*' --exclude='.kickoff/backups' \
    .kickoff 2>/dev/null || die "$ORG: backup failed ($BK) — refusing to proceed without one"
  say "• backup: $BK"
else
  BK=""
  while IFS= read -r _cand; do
    if [ "$(bk_tag "$_cand")" != "$TAG" ]; then BK="$_cand"; break; fi
  done < <(ls -1t "$BACKUP_DIR/$BACKUP_PREFIX"-*.tar.gz 2>/dev/null || true)
  if [ -n "$BK" ]; then
    say "• pin already at $TAG — NOT snapshotting the post-upgrade state; pre-upgrade backup: $BK"
  else
    say "• pin already at $TAG — NOT snapshotting the post-upgrade state (and no pre-upgrade backup exists)"
  fi
fi
if [ -n "$BK" ]; then RB_HINT="rollback anytime:  bash $0 --rollback $BK"
else RB_HINT="rollback: no pre-upgrade backup exists — pass an archive explicitly (bash $0 --rollback <backup.tar.gz>)"; fi
say "  $RB_HINT"
hr

# ── THE PULL — the CURRENT engine's front door hops to the new tag ────────────
say "• pulling $TAG via the current engine's front door…"
PULL_LOG="$(mktemp)"
PULL_RC=0
env "${SCRUB[@]}" ${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"} REPO_DIR="$REPO" \
  timeout 600 bash "$OLD_ENGINE/scripts/kickoff" pull "$TAG" 2>&1 | tee "$PULL_LOG"
PULL_RC=${PIPESTATUS[0]}
hr

# ── CONJUNCTIVE pull verdict (evaluate every leg; adjudicate on core.lock, never rc alone) ──
NEW_ENGINE="$(read_env_var KICKOFF_CORE_DIR)"
NEW_TAG="$(lock_field tag)"; NEW_COMMIT="$(lock_field commit)"
ENG_HEAD="$(git -C "$NEW_ENGINE" rev-parse HEAD 2>/dev/null || true)"
ENG_TAG="$(git -C "$NEW_ENGINE" describe --tags --exact-match 2>/dev/null || true)"
V_OK=1
leg(){ if eval "$2"; then say "  ✓ $1"; else say "  ✗ $1"; V_OK=0; fi; }
say "PULL VERDICT (conjunctive):"
leg "pull rc == 0 (got $PULL_RC)"                       "[ $PULL_RC -eq 0 ]"
leg "anchored 'PULL OK' present"                        "grep -Eq '^\[kickoff [^]]*\] PULL OK' \"$PULL_LOG\""
leg "zero '[kickoff] ERROR:' lines"                     "! grep -q '^\[kickoff\] ERROR:' \"$PULL_LOG\""
leg "core.lock tag advanced to $TAG (got ${NEW_TAG:-<none>})"        "[ \"$NEW_TAG\" = \"$TAG\" ]"
leg "core.lock commit == new engine HEAD (${NEW_COMMIT:0:7} vs ${ENG_HEAD:0:7})" "[ -n \"$NEW_COMMIT\" ] && [ \"$NEW_COMMIT\" = \"$ENG_HEAD\" ]"
leg "new engine checkout IS the tag ($NEW_ENGINE @ ${ENG_TAG:-<none>})"          "[ \"$ENG_TAG\" = \"$TAG\" ]"
if [ "$V_OK" != 1 ]; then
  say ""
  die "$ORG: PULL VERDICT FAILED — the OLD worker was NOT touched and keeps running. Read the pull output above (a #6/#8 line = pin problem; core.lock is the arbiter). $RB_HINT"
fi
say "  → pin coherent: $NEW_ENGINE @ $TAG (${NEW_COMMIT:0:7})"
hr

# ── persist ONLY the pins the adopter actually HAD — an upgrade changes the VERSION, never the model
#    policy. A real MODEL/EFFORT pin is made hop-durable (the v0.7+ engine hop DROPS env MODEL/EFFORT
#    and re-resolves from instance.env, so without the persist the first post-hop pull would silently
#    revert to the box default). A NO-PIN adopter is left EXACTLY as found: NOTHING persisted, so the
#    re-resolve lands on the box default (inherit-box model, effort high) — which is what that adopter
#    already ran. Imposing opus/xhigh here is the 2026-07-13 miss in reverse (a silent, durable policy
#    change on a default adopter). PERMISSION_MODE is NEVER written here (see header). ──
if [ "$MODEL_PINNED" = 1 ]; then
  persist_env_var MODEL "$WORKER_MODEL"
  grep -qxF "export MODEL=\"$WORKER_MODEL\"" "$IENV" || die "$ORG: MODEL persist into $IENV did not verify — inspect the file"
fi
if [ "$EFFORT_PINNED" = 1 ]; then
  persist_env_var EFFORT "$WORKER_EFFORT"
  grep -qxF "export EFFORT=\"$WORKER_EFFORT\"" "$IENV" || die "$ORG: EFFORT persist into $IENV did not verify — inspect the file"
fi
if [ "$MODEL_PINNED" = 1 ] || [ "$EFFORT_PINNED" = 1 ]; then
  say "• persisted the adopter's OWN pin ($MODEL_DISPLAY EFFORT=$WORKER_EFFORT) into instance.env (hop-durable — THEIR pin, preserved)"
else
  say "• no MODEL/EFFORT pin in instance.env — persisted NOTHING; the worker inherits the box model at effort high, exactly as the bare engine does (an upgrade changes the VERSION, never the policy)"
fi

# ── keep the push-side connection alive for this repo's own future gate batteries (idempotent) ──
ensure_ssh_keepalive

# ── stop the OLD supervisor, then start from the NEW engine ───────────────────
stop_old_supervisor
say "• starting the worker from the NEW engine:  kickoff @@UP_ARGS@@  (@@PM@@ · $MODEL_DISPLAY · EFFORT=$WORKER_EFFORT)"
UP_RC=0
env "${SCRUB[@]}" ${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"} REPO_DIR="$REPO" \
  "${POLICY_ENV[@]}" \
  timeout 120 bash "$NEW_ENGINE/scripts/kickoff" @@UP_ARGS@@ || UP_RC=$?
if [ "$UP_RC" -ne 0 ]; then
  tail_log
  die "$ORG: kickoff @@UP_ARGS@@ exited $UP_RC — the fail-closed preflight likely blocked it (see log above). Fix + re-run — or $RB_HINT"
fi

# ── ${WATCH_SECONDS}s survival check: alive AND from the NEW engine dir, continuously ─────
say "• watchdog: ${WATCH_SECONDS}s survival check (pid alive + /proc cmdline names the NEW engine)…"
NEW_PID="$(sup_pid)"
is_alive "$NEW_PID" || { tail_log; die "$ORG: no live supervisor pid in $LOCK right after up — investigate"; }
ELAPSED=0
while [ "$ELAPSED" -lt "$WATCH_SECONDS" ]; do
  if ! is_alive "$NEW_PID"; then
    tail_log
    die "$ORG: new supervisor pid $NEW_PID DIED after ${ELAPSED}s (watchdog) — see log above. $RB_HINT"
  fi
  if ! sup_cmdline "$NEW_PID" | grep -qF "$NEW_ENGINE/scripts/supervisor.sh"; then
    die "$ORG: supervisor pid $NEW_PID runs from an UNEXPECTED path ($(sup_cmdline "$NEW_PID")) — expected $NEW_ENGINE/scripts/supervisor.sh"
  fi
  sleep 3; ELAPSED=$((ELAPSED+3))
done

# ── final conjunctive verdict ─────────────────────────────────────────────────
hr
say "FINAL VERDICT (all conjunctive legs green):"
say "  ✓ pull rc==0 + anchored PULL OK + zero '[kickoff] ERROR:'"
say "  ✓ core.lock advanced: $TAG @ ${NEW_COMMIT:0:7} == $NEW_ENGINE HEAD"
say "  ✓ old supervisor stopped clean (exact verified pid)"
say "  ✓ new supervisor pid $NEW_PID alive from $NEW_ENGINE for ${WATCH_SECONDS}s (@@PM@@ · $MODEL_DISPLAY · EFFORT=$WORKER_EFFORT)"
if [ "$MODEL_PINNED" = 1 ] || [ "$EFFORT_PINNED" = 1 ]; then
  say "  ✓ $MODEL_DISPLAY EFFORT=$WORKER_EFFORT persisted in instance.env — THEIR pin, preserved across the hop"
else
  say "  ✓ no MODEL/EFFORT pin to persist — worker inherits the box model at effort high (engine default), policy untouched across the hop"
fi
say ""
say "✅ $ORG is on $TAG."
say "   stop the worker anytime:  kill -TERM \"\$(cat $LOCK)\""
