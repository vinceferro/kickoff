# instance.env.example — the per-instance config contract for a kickoff adopter.
#
# WHAT THIS IS
#   kickoff's core scripts (session-run.sh, mc-update.py, the memory-retrieval layer)
#   are PARAMETER-CLEAN: everything that differs between one adopter and the next lives
#   in ONE file — .kickoff/instance.env — which the launcher sources at spawn. This lets
#   an adopter PULL the core unchanged (no hand-patched copy) and supply only their own
#   values here. The set of variable NAMES below is the stability contract between core
#   and adopters; they change only across core versions (see CORE-CHANGELOG).
#
# HOW TO USE (adopter)
#   1. cp scripts/instance.env.example .kickoff/instance.env
#   2. Fill in the REQUIRED values (marked ⛔ below). .kickoff/ is PARTLY tracked; the
#      generated `.kickoff/.gitignore` keeps instance.env + derived state out of git — your
#      real channel/paths never get committed.
#   3. Launch as usual (bash scripts/start-supervisor.sh). The launcher fails LOUD if a
#      required value is missing — no silent inheritance of origin's channel.
#
# FORM
#   `export VAR="${VAR:-default}"` — a value passed in the environment still wins over
#   this file (one-off overrides), otherwise the file's default applies, and the var is
#   exported so the worker session + all its Bash tools inherit it.

# ══════════════════════════════════════════════════════════════════════════════
# ⛔ REQUIRED — no safe default; the launcher exits if unset
# ══════════════════════════════════════════════════════════════════════════════

# The Telegram channel state dir for THIS instance. MUST be distinct per instance:
# one bot token = one getUpdates consumer, so two instances sharing a state dir/token
# fight over inbound messages (the double-poller footgun). Point this at a DEDICATED
# worker bot's channel — never origin's.
# Sample: $HOME/.claude/channels/telegram-YOUR-WORKER (a DEDICATED worker bot's dir). Empty on
# purpose — copy-and-forget must FAIL LOUD, not launch on a shared placeholder channel.
export TELEGRAM_STATE_DIR="${TELEGRAM_STATE_DIR:-}"

# ══════════════════════════════════════════════════════════════════════════════
# Telegram bridge plugin (optional — the official plugin is the only supported one)
# ══════════════════════════════════════════════════════════════════════════════

# CHANNEL_SPEC — WHICH telegram plugin serves this worker's bridge (--channels spec;
# tagged plugin:<name>@<marketplace> form required — a bare plugin:telegram is a
# parse error). Default (unset): the official claude-plugins-official copy. Leave it.
# THE RULE — multi-project isolation is a STATE-DIR + TOKEN concern, never a plugin
# fork: run ONE official telegram@claude-plugins-official and give each project its
# own TELEGRAM_STATE_DIR + TELEGRAM_BOT_TOKEN (one plugin, N isolated bots). A custom
# channel plugin is not on the approved-channels allowlist, so its bridge exits at
# boot and the worker goes silently deaf.
# export CHANNEL_SPEC="${CHANNEL_SPEC:-plugin:telegram@claude-plugins-official}"

# ══════════════════════════════════════════════════════════════════════════════
# ⚠️ DEPLOY SAFETY (conditional — set this IF your repo is push=deploy)
# ══════════════════════════════════════════════════════════════════════════════

# DEPLOY_BRANCH — the branch whose push triggers a REAL deploy (a Vercel/Netlify/
# CI-on-push pipeline, a push=deploy setup). Declaring it ACTIVATES preflight check #5,
# the deploy-fence: preflight then REQUIRES a `permissions.deny` rule in
# .claude/settings*.json that actually blocks a bare `git push` (e.g. Bash(git push:*) or
# Bash(git push)) and FAILS CLOSED if it's missing. Left UNSET, the fence is SKIPPED — so
# if a push to your repo can deploy AND you run an `--auto` worker, an accidental or
# agent-initiated push could reach production UNFENCED. If a push deploys, SET THIS
# (and add the matching git-push deny). Uncomment + set to your deploy branch:
# export DEPLOY_BRANCH="${DEPLOY_BRANCH:-main}"

# ══════════════════════════════════════════════════════════════════════════════
# Memory
# ══════════════════════════════════════════════════════════════════════════════

# The memory index file the re-ground prompt points the worker at first. Interpolated
# into REGROUND_PROMPT by the launcher, so you set the path here, not in the prompt.
# REPO-RELATIVE by design (unlike the ${REPO_DIR:-$PWD}-anchored derived paths below): it is
# prompt TEXT the worker reads from the repo cwd, and every consumer anchors it on YOUR repo
# when not absolute (preflight #3 resolves it against REPO_DIR; eject absolutizes it against
# the target before archiving/relocating/deleting). An absolute path also works.
export MEMORY_INDEX="${MEMORY_INDEX:-.kickoff/memory/MEMORY.md}"

# The memory facts directory the retrieval hook indexes — the TRACKED memory CORPUS (the .md
# corpus is a durable, team-shareable adopter asset, so it lives UNDER .kickoff/memory/, not the
# ignored .kickoff/state/). ACTIVE so a copy-and-forget resolves into YOUR repo
# (${REPO_DIR:-$PWD}/.kickoff/memory), never the shared core clone the retrieval code may be
# PULLED from. Namespacing under .kickoff/memory/ also avoids colliding with a pre-existing memory/.
export MEMORY_DIR="${MEMORY_DIR:-${REPO_DIR:-$PWD}/.kickoff/memory}"

# The hybrid retrieval index DB + hook log — DERIVED, churning caches, so they land under the
# IGNORED .kickoff/state/ (never committed). ⚠️ If you PULL the retrieval code from a shared core
# checkout (~/kickoff-core/), the code's own location is the CORE, not your data — so these are
# ACTIVE and anchored on YOUR repo (${REPO_DIR:-$PWD}) so the derived index + log land in your
# repo, never the shared core. Override with an absolute path.
export MEMORY_DB="${MEMORY_DB:-${REPO_DIR:-$PWD}/.kickoff/state/memory-retrieval/memory-index.db}"
export MEMORY_HOOK_LOG="${MEMORY_HOOK_LOG:-${REPO_DIR:-$PWD}/.kickoff/state/memory-retrieval/retrieval-log.jsonl}"

# Retrieval tuning floors (INSTANCE-tuned — kickoff 0.20, Bliz 0.30). Set to your
# corpus's tuned values; the hook wiring reads these from the environment.
# export MEMORY_HOOK_VEC_FLOOR="${MEMORY_HOOK_VEC_FLOOR:-0.20}"
# export MEMORY_HOOK_BM25_FLOOR="${MEMORY_HOOK_BM25_FLOOR:--8.0}"

# The LOCAL SEMANTIC EMBEDDING MODEL lives in a PULL-DURABLE per-machine cache —
# ~/.cache/kickoff-models (XDG-aware) — NEVER inside the core clone's node_modules,
# so a `kickoff pull` cannot lose it (core-v0.4). The default needs NO config and is
# shared by every adopter on the box. KICKOFF_MODEL_DIR relocates it;
# KICKOFF_MODEL_OFFLINE=1 pins fully-offline behaviour (a missing model then fails
# LOUD instead of fetching). NOTE: these are read from the PROCESS ENVIRONMENT (the
# retrieval tool + install-model.mjs) — they are not on the launcher's instance.env
# whitelist, so export them in the shell/service that runs the session if you
# override them. (Re)install/heal the model any time:
#   node $KICKOFF_CORE_DIR/memory-retrieval/install-model.mjs
# KICKOFF_MODEL_DIR=/absolute/path/to/models
# KICKOFF_MODEL_OFFLINE=1

# ══════════════════════════════════════════════════════════════════════════════
# Mission Control
# ══════════════════════════════════════════════════════════════════════════════

# The mission-state.json this instance's mc-update.py reads/writes. ACTIVE and anchored on
# YOUR repo (${REPO_DIR:-$PWD}) so a copy-and-forget writes the board into your repo — not
# the shared core clone (mc-update.py's BASE_DIR default would otherwise resolve into the
# core, blanking the operator's board). If you PULL, mc-update.py ALSO fail-loud-refuses to
# write when this is unset and it's running from a detached-HEAD core clone. Absolute path.
# DERIVED runtime state → lands under the IGNORED .kickoff/state/ (never committed).
export MC_STATE_FILE="${MC_STATE_FILE:-${REPO_DIR:-$PWD}/.kickoff/state/mission-control/mission-state.json}"

# The rendered TRACKER.md companion (mc-update.py render-tracker writes it). A DERIVED render →
# under the IGNORED .kickoff/state/; anchored on YOUR repo, so it lands there, not the core.
# export MC_TRACKER_FILE="${MC_TRACKER_FILE:-${REPO_DIR:-$PWD}/.kickoff/state/TRACKER.md}"

# The 3D universe deck (GET /universe on the MC server) — OPT-IN, default OFF. Unset/0 →
# the route is disabled (404) and the dashboard hides its 🌌 link; =1 → server.py serves
# the deck and the dashboard shows the link (it discovers the flag via GET /config, which
# returns capability BOOLEANS only). Purely additive eye-candy — the 2D board is complete
# without it. NOTE: read from the PROCESS ENVIRONMENT of server.py at start — it is not on
# the launcher's instance.env whitelist, so export it in the shell/service that runs the
# MC server (then restart the server to flip it). Uncomment (=1) to enable:
# export KICKOFF_UNIVERSE="${KICKOFF_UNIVERSE:-1}"

# Universe THEME (S4): the deck's palette + bounded knobs + strings live in
# .kickoff/universe.theme.json (seeded at adopt from the core default — yours to edit;
# save + reload /universe, no server restart). server.py finds it by walking up from the
# state file to the .kickoff/ dir; set KICKOFF_UNIVERSE_THEME=/abs/path/theme.json in the
# server's environment only for unusual layouts. The organic FORMS are fixed — a theme
# retints + rescales within bounds; it cannot make the cosmos hard-geometric.

# ══════════════════════════════════════════════════════════════════════════════
# Core pull (R3 — `kickoff pull`)
# ══════════════════════════════════════════════════════════════════════════════
# `kickoff pull [<tag>]` keeps this adopter on a PINNED core (a `core-v*` git tag) WITHOUT
# hand-copying core files: it maintains a SEPARATE read-only clone and regenerates
# .kickoff/core.lock, which preflight check #6 then ENFORCES (any drift = a copied-and-patched
# core file = fail-closed).

# The separate read-only core clone `kickoff pull` maintains. NEVER edit files inside it — it is
# checked out detached at the pinned tag, and core.lock records its checksums. Kept ACTIVE (not
# commented): `kickoff pull` writes core.lock relative to this dir AND preflight check #6 reads it
# from here — they must AGREE, so instance.env sets it once. (Default: $HOME/kickoff-core)
export KICKOFF_CORE_DIR="${KICKOFF_CORE_DIR:-$HOME/kickoff-core}"

# Where `kickoff pull` clones/fetches the core from. Empty → kickoff derives it from THIS repo's
# `origin` remote URL (git -C <repo> remote get-url origin). Set it to pin to a specific origin.
# export KICKOFF_CORE_REMOTE="${KICKOFF_CORE_REMOTE:-}"

# ══════════════════════════════════════════════════════════════════════════════
# Worker charter (advanced — usually leave to the core default)
# ══════════════════════════════════════════════════════════════════════════════

# The re-ground system-prompt append. The core default already reads $MEMORY_INDEX, so
# you normally set the var above, NOT this. Override only to change the worker's
# operating charter wholesale.
# export REGROUND_PROMPT="${REGROUND_PROMPT:-...}"

# ══════════════════════════════════════════════════════════════════════════════
# Box policy (optional)
# ══════════════════════════════════════════════════════════════════════════════

# Permission mode: 'default' (relay gated actions to the operator) or 'auto' (execute
# reversible work unprompted). 'auto' is a deliberate at-the-terminal grant.
# export PERMISSION_MODE="${PERMISSION_MODE:-default}"

# Reasoning effort tier: low | medium | high | xhigh | max.
# export EFFORT="${EFFORT:-high}"

# Pin the coordinator's MODEL — a model FAMILY alias (sonnet | opus), NOT a versioned string
# (a family alias won't rot as new versions roll). DEFAULT UNSET ⇒ inherit the box's Claude Code
# model config — today's exact behaviour (the launcher adds NO --model, so nothing changes).
# NOTE: like KICKOFF_MODEL_DIR above, MODEL is read from the PROCESS ENVIRONMENT — it is NOT on the
# launcher's instance.env whitelist, so setting it HERE alone won't take effect. Set it via
# `MODEL=opus bash scripts/go-autonomous.sh`, a one-off `MODEL=opus bash scripts/session-run.sh`,
# or the shell/service that launches the supervisor. Uncomment to pin:
# MODEL=opus

# Max concurrent specialist agents this box will fan out (load headroom).
# export MAX_CONCURRENT_AGENTS="${MAX_CONCURRENT_AGENTS:-4}"

# Optional session-refresh cadence in minutes (also `kickoff up --cadence N`): the supervisor
# cycles a fresh, re-grounded session on this interval. Unset → refresh only on the degradation
# flag or a Telegram /refresh (see RUNNING.md).
# export CADENCE="${CADENCE:-}"

# ══════════════════════════════════════════════════════════════════════════════
# Auth self-heal (optional — INERT by default; scripts/auth-heal.sh)
# ══════════════════════════════════════════════════════════════════════════════
# The supervisor's Claude-Code token-expiry self-heal: a non-interactive auth probe
# (+ an exit-loop backstop) detects an expired credential, PAUSES the doomed restart
# loop, sends one tokenless Telegram alert with the fix (claude setup-token on a
# browser machine → bash scripts/relogin.sh on the box), then AUTO-RESUMES the moment
# auth is valid again. Requires the two staged supervisor edits
# (bash scripts/install-auth-heal.sh — dry-runs by default). EVERYTHING here is OFF
# by default: with KICKOFF_AUTH_HEAL unset/0 the supervisor behaves exactly as today.
# These knobs are re-read from this file on EVERY supervisor poll — arming/tuning
# takes effect within ~15s, no supervisor restart needed.

# Master switch. Uncomment (=1) to arm. 0/unset = fully inert.
# export KICKOFF_AUTH_HEAL="${KICKOFF_AUTH_HEAL:-1}"

# The read-only auth probe (D3). Default when armed: `claude auth status --json`
# (CC ≥2.1.203; rc!=0 — or rc==0 with "loggedIn": false — counts as a failed probe).
# `none` disables the probe (exit-loop detection only). Runs as the supervisor user —
# operator config, the same trust level as the supervisor's START_CMD.
# export KICKOFF_AUTH_CHECK_CMD="${KICKOFF_AUTH_CHECK_CMD:-claude auth status --json}"

# Optional NON-INTERACTIVE credential refresh, tried once per cooldown before
# escalating. EMPTY by default on purpose: Claude Max/OAuth is hard-expiry (no refresh
# token), so an expiry escalates straight to the relogin.sh turnkey. Set only if YOUR
# auth path really has a refresher (e.g. an apiKeyHelper-style rotation).
# export KICKOFF_AUTH_REFRESH_CMD="${KICKOFF_AUTH_REFRESH_CMD:-}"

# Tuning (defaults shown — uncomment to change):
# export KICKOFF_AUTH_CHECK_INTERVAL="${KICKOFF_AUTH_CHECK_INTERVAL:-300}"      # healthy-probe period, s
# export KICKOFF_AUTH_RECHECK_INTERVAL="${KICKOFF_AUTH_RECHECK_INTERVAL:-60}"   # probe period while escalated, s
# export KICKOFF_AUTH_FAILS_TO_ESCALATE="${KICKOFF_AUTH_FAILS_TO_ESCALATE:-2}"  # consecutive probe fails = expired
# export KICKOFF_AUTH_EARLY_DEATH_SECONDS="${KICKOFF_AUTH_EARLY_DEATH_SECONDS:-60}"           # exit-loop window T (0 = off)
# export KICKOFF_AUTH_EARLY_DEATHS_TO_ESCALATE="${KICKOFF_AUTH_EARLY_DEATHS_TO_ESCALATE:-3}"  # exit-loop streak N
# export KICKOFF_AUTH_ALERT_COOLDOWN="${KICKOFF_AUTH_ALERT_COOLDOWN:-1800}"     # ≥s between alerts / refresh attempts
# export KICKOFF_AUTH_MAX_AUTO_RESUMES="${KICKOFF_AUTH_MAX_AUTO_RESUMES:-3}"    # failed recoveries before wait-for-relogin
# export KICKOFF_AUTH_PROBE_TIMEOUT="${KICKOFF_AUTH_PROBE_TIMEOUT:-30}"         # probe hard timeout, s
